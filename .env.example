# Supabase configuration (optional - local in-memory fallback enabled by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Secret for /admin
ADMIN_PASSWORD=venlix-spot-admin

# Email Service API (Resend) - falls back to console logging when not set
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Spot The Event <onboarding@resend.dev>
NOTIFICATION_EMAIL=mylaramshashank@gmail.com
