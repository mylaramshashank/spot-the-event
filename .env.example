# Supabase Configuration (Optional - App gracefully defaults to client localStorage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key

# Admin Authentication (Required before enabling /admin in production)
# Set a strong password (min 8 chars) and random session secret (min 16 chars)
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-64-char-random-session-secret

# Email Notifications via Resend (Optional)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Spot the Event <onboarding@resend.dev>
NOTIFICATION_EMAIL=your-notification-email@example.com
